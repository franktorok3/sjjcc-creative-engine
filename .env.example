NEXT_PUBLIC_APP_URL=http://localhost:3000
GOOGLE_FORM_WEBHOOK_SECRET=

# Test-only operating mode (defaults keep live Google Form isolated)
# CREATIVE_ENGINE_GOOGLE_FORM_PROCESSING_ENABLED=false
# CREATIVE_ENGINE_BASECAMP_POSTING_ENABLED=true

# Canva Connect API (do not commit real secrets)
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_REDIRECT_URI=http://localhost:3000/api/canva/callback
CANVA_BRAND_TEMPLATE_ID=
CANVA_ACCESS_TOKEN=
CANVA_REFRESH_TOKEN=
# Durable token store for auto-renew on Vercel (Vercel KV / Upstash Redis REST).
# Required in Production so rotated Canva refresh tokens can be persisted.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# Or:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# CREDENTIAL_ENCRYPTION_KEY= # encrypts token payloads in KV + local .data store
# Optional: override default scopes / poll tuning
# CANVA_SCOPES=asset:read asset:write brandtemplate:content:read brandtemplate:meta:read design:content:read design:content:write design:meta:read profile:read
# CANVA_AUTOFILL_POLL_MS=2000
# CANVA_AUTOFILL_MAX_ATTEMPTS=30
# CREDENTIAL_ENCRYPTION_KEY=

# Basecamp / 37signals Launchpad OAuth app
BASECAMP_CLIENT_ID=
BASECAMP_CLIENT_SECRET=
BASECAMP_REDIRECT_URI=http://localhost:3000/api/basecamp/callback
# After visiting /api/basecamp/connect (or paste tokens):
BASECAMP_ACCESS_TOKEN=
BASECAMP_REFRESH_TOKEN=
BASECAMP_ACCOUNT_ID=
BASECAMP_MESSAGE_BOARD_ID=
BASECAMP_USER_AGENT=SJJCC-Creative-PoC (you@example.com)

# Temporary PoC only — set to 1 while copying OAuth tokens into Vercel env, then remove.
# OAUTH_EXPORT_TOKENS=1

# Operator admin routes (shell generation). Optional override; otherwise
# GOOGLE_FORM_WEBHOOK_SECRET is accepted for X-Admin-Secret (PoC only).
# CREATIVE_ENGINE_ADMIN_SECRET=

# Optional approved Brand Kit logo assets (never invent IDs)
# CANVA_SJJCC_LOGO_ASSET_ID=
# CANVA_UJA_LOGO_ASSET_ID=
